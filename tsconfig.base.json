{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@org/muddy-code-pms-shell": [
        "libs/shells/muddy-code-pms-shell/src/index.ts"
      ],
      "@org/muddy-code-wms-shell": [
        "libs/shells/muddy-code-wms-shell/src/index.ts"
      ],
      "@org/muddy-code-dashboard-shell": ["libs/shells/muddy-code-dashboard-shell/src/index.ts"],
      "@org/dashboard-features": [
        "libs/features/dashboard-features/src/index.ts"
      ],
      "@org/pms-technology": [
        "libs/features/pms-features/pms-technology/src/index.ts"
      ],
      "@org/wms-barcodes": [
        "libs/features/wms-features/wms-barcodes/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
